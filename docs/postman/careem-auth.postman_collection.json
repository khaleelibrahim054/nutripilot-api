{
  "info": {
    "name": "NutriPilot - Careem Auth",
    "_postman_id": "6f1d2b8e-3c4a-4f1e-9b7a-2d5e8c9a1f30",
    "description": "Manual test of Careem sign-in (docs/architecture/careem-identity.md).\n\nOrder: 1 Health -> 2 Start -> open {{authorization_url}} in a browser and sign in -> paste the full URL Careem redirected to into the collection variable `redirect_url` -> 3 Callback -> 4 Session.\n\nThe Start request generates a fresh client_verifier / S256 client_challenge (the mobile app's handoff binding). Callback reads code/state from `redirect_url`. Run Start again for every new login attempt (each is single-use, 10 min).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "client_verifier", "value": "" },
    { "key": "client_challenge", "value": "" },
    { "key": "authorization_url", "value": "" },
    { "key": "redirect_url", "value": "" },
    { "key": "code", "value": "" },
    { "key": "state", "value": "" },
    { "key": "id_token", "value": "" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API and database are up', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().database).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Start Careem login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/careem/start",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_challenge\": \"{{client_challenge}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// What the mobile app does: keep a secret verifier, send only its S256 hash.",
              "const b64url = (words) => CryptoJS.enc.Base64.stringify(words)",
              "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "const verifier = b64url(CryptoJS.lib.WordArray.random(48)); // 64 chars",
              "const challenge = b64url(CryptoJS.SHA256(verifier));        // 43 chars",
              "pm.collectionVariables.set('client_verifier', verifier);",
              "pm.collectionVariables.set('client_challenge', challenge);",
              "pm.collectionVariables.set('redirect_url', '');",
              "pm.collectionVariables.set('code', '');",
              "pm.collectionVariables.set('state', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns the Careem authorization URL', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.authorization_url).to.match(/\\/authorize\\?/);",
              "  pm.expect(body.expires_in).to.eql(600);",
              "  pm.collectionVariables.set('authorization_url', body.authorization_url);",
              "});",
              "console.log('Open this URL in a browser and sign in with Careem:');",
              "console.log(pm.collectionVariables.get('authorization_url'));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Complete Careem login (callback)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/careem/callback",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{code}}\",\n  \"state\": \"{{state}}\",\n  \"client_verifier\": \"{{client_verifier}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Paste the full redirect URL (…?code=…&state=…) into the `redirect_url` variable.",
              "const redirect = pm.collectionVariables.get('redirect_url') || '';",
              "const query = (redirect.split('?')[1] || '').split('#')[0];",
              "query.split('&').filter(Boolean).forEach((pair) => {",
              "  const [key, value = ''] = pair.split('=');",
              "  if (key === 'code' || key === 'state') {",
              "    pm.collectionVariables.set(key, decodeURIComponent(value.replace(/\\+/g, ' ')));",
              "  }",
              "  if (key === 'error') { console.warn('Careem returned error=' + decodeURIComponent(value)); }",
              "});",
              "if (!pm.collectionVariables.get('code')) {",
              "  console.warn('No code found: set the `redirect_url` collection variable first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login succeeds and returns the bearer ID token', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.token_type).to.eql('bearer');",
              "  pm.expect(body).to.not.have.property('access_token');",
              "  pm.expect(body).to.not.have.property('refresh_token');",
              "  pm.collectionVariables.set('id_token', body.id_token);",
              "  pm.collectionVariables.set('user_id', body.user_id);",
              "  console.log('user_id', body.user_id, 'new user:', body.is_new_user, 'expires_in', body.expires_in);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Current session",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{id_token}}" }],
        "url": "{{baseUrl}}/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token resolves to the logged-in user', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user_id).to.eql(pm.collectionVariables.get('user_id'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Negative checks",
      "item": [
        {
          "name": "Replay callback (expect 400 invalid_state)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/careem/callback",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{code}}\",\n  \"state\": \"{{state}}\",\n  \"client_verifier\": \"{{client_verifier}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a used login attempt cannot be replayed', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('invalid_state');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Session without token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unauthenticated', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('unauthenticated');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Session with forged token (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJub25lIiwia2lkIjoiNDM5MGExNDQtOTA2YS00OWViLThmZmQtNjE0ODA1YzJkMTI0In0.eyJzdWIiOiI5MjMwNTcwOSJ9."
              }
            ],
            "url": "{{baseUrl}}/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('alg=none token is rejected', () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Start with extra field (expect 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/careem/start",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_challenge\": \"E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM\",\n  \"user_id\": \"someone-else\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mass assignment rejected', () => {",
                  "  pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
