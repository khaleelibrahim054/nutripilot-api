# Copy to .env and adjust. Every value is read through app.core.config.Settings.

APP_NAME="NutriPilot API"
# local | test | staging | production  (API docs are disabled in production)
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR  (logs are JSON lines on stdout)
LOG_LEVEL=INFO

# Single PostgreSQL database shared by every module (async driver required).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careem
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JSON list of allowed browser origins; empty disables CORS.
CORS_ORIGINS=[]

# AI/MCP service: a separate application this API calls over HTTP + SSE.
AI_SERVICE_URL=http://localhost:8100
# Connect/write timeout, and the maximum silence between streamed chunks.
AI_SERVICE_TIMEOUT_SECONDS=10
AI_SERVICE_STREAM_IDLE_TIMEOUT_SECONDS=60

# Careem sign-in (see docs/architecture/careem-identity.md and https://builders.careem.com/docs).
# Login returns 503 until the client ID, redirect URI and encryption key are all set.
# Client ID: request one at https://builders.careem.com/request-access.
CAREEM_CLIENT_ID=
# Leave empty: Careem issues public clients (PKCE, no secret). Set only if Careem gives you a
# confidential client; it is then sent with client_secret_basic.
CAREEM_CLIENT_SECRET=
# Must exactly match a redirect URI registered for your client (list it when requesting access).
# Prefer an https App Link / Universal Link over a custom scheme in production.
CAREEM_REDIRECT_URI=nutripilot://auth/careem/callback
CAREEM_SCOPES=["openid","profile","offline_access"]
# Careem MCP server, called with the user's Careem access token.
# CAREEM_MCP_URL=https://mcp.careemapis.com/mcp
# Fernet key for PKCE verifiers and Careem tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=
# Verified Careem endpoints (defaults); override only if Careem changes them.
# CAREEM_ISSUER=https://identity.careem.com/
# CAREEM_AUTHORIZATION_ENDPOINT=https://identity.careem.com/authorize
# CAREEM_TOKEN_ENDPOINT=https://identity.careem.com/token
# CAREEM_JWKS_URI=https://identity.careem.com/jwk
# CAREEM_JWT_LEEWAY_SECONDS=60
# CAREEM_ID_TOKEN_MAX_AGE_SECONDS=600
# CAREEM_JWKS_CACHE_TTL_SECONDS=3600
# CAREEM_JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
# OAUTH_TRANSACTION_TTL_SECONDS=600
# Sandbox (https://builders.careem.com/docs/authentication): uncomment to test against QA.
# CAREEM_ISSUER=https://identity.qa.careem-engineering.com/
# CAREEM_AUTHORIZATION_ENDPOINT=https://identity.qa.careem-engineering.com/authorize
# CAREEM_TOKEN_ENDPOINT=https://identity.qa.careem-engineering.com/token
# CAREEM_JWKS_URI=https://identity.qa.careem-engineering.com/jwk
# CAREEM_MCP_URL=https://mcp.sandbox.careemapis.com/mcp

# Used by the test suite only. The database name must end in _test.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careem_test
